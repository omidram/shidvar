NODE_ENV=development
APP_URL=http://localhost:5500
APP_NAME=Shidvar

DATABASE_URL=postgresql://shidvar:shidvar@localhost:5433/shidvar
REDIS_URL=redis://localhost:6379

SESSION_SECRET=replace-with-at-least-32-characters-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/private
STORAGE_ENDPOINT=
STORAGE_BUCKET=shidvar-docs
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

EMAIL_PROVIDER=console
SMS_PROVIDER=apiir
SMS_OTP_API_URL=https://s.api.ir/api/sw1/SmsOTP
SMS_OTP_API_KEY=
SMS_OTP_TEMPLATE=1
PUSH_PROVIDER=console
MAP_PROVIDER=osm
PAYMENT_PROVIDER=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_ACCESS_TOKEN=
ZARINPAL_TERMINAL_ID=

DEFAULT_LOCALE=fa
DEFAULT_CURRENCY=IRR
DEFAULT_COUNTRY=IR

# Optional
OTEL_DSN=
SENTRY_DSN=
